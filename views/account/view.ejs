<% layout('layout/boilerplate') %>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        .glass-effect {
background-color: #161b22;
    border: 1px solid rgba(0, 255, 255, 0.2);
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.2);
        }
        .order-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(5px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }
        .order-card:hover {
            background: rgba(255, 255, 255, 0.1);
            transform: translateY(-2px);
        }
    </style>


    <div class="container mx-auto px-4 max-w-6xl mt-5">
        <!-- Account Header -->
        <div class="glass-effect rounded-2xl p-8 mb-8">
            <div class="flex items-center space-x-6">
                <div class="w-20 h-20 bg-gradient-to-br from-cyan-400 to-blue-600 rounded-full flex items-center justify-center">
                    <i class="fas fa-user text-3xl text-white"></i>
                </div>
                <div>
                    <h1 class="text-4xl font-bold mb-2">Welcome back, <%= currentUser.username %>!</h1>
                    <p class="text-gray-300 text-lg">
                        <i class="fas fa-envelope mr-2"></i><%= currentUser.email %>
                    </p>
                    <p class="text-gray-300 text-sm mt-1">
                        <i class="fas fa-calendar-alt mr-2"></i>Member since <%= new Date(currentUser.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                    </p>
                </div>
            </div>
        </div>

        <!-- Account Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="glass-effect rounded-xl p-6 text-center">
                <div class="text-3xl font-bold text-cyan-400 mb-2"><%= orders.length %></div>
                <div class="text-gray-300">Total Orders</div>
            </div>
            <div class="glass-effect rounded-xl p-6 text-center">
                <div class="text-3xl font-bold text-green-400 mb-2">
                    ₹<%= orders.reduce((sum, order) => sum + order.total, 0).toLocaleString() %>
                </div>
                <div class="text-gray-300">Total Spent</div>
            </div>
            <div class="glass-effect rounded-xl p-6 text-center">
                <div class="text-3xl font-bold text-purple-400 mb-2">
                    <%= currentUser.cart ? currentUser.cart.length : 0 %>
                </div>
                <div class="text-gray-300">Items in Cart</div>
            </div>
        </div>

        <!-- Order History -->
        <div class="glass-effect rounded-2xl p-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-3xl font-bold">
                    <i class="fas fa-history mr-3 text-cyan-400"></i>Order History
                </h2>
                <% if (orders.length > 0) { %>
                    <span class="text-gray-300"><%= orders.length %> order<%= orders.length !== 1 ? 's' : '' %></span>
                <% } %>
            </div>

            <% if (orders.length === 0) { %>
                <div class="text-center py-12">
                    <i class="fas fa-shopping-bag text-6xl text-gray-500 mb-4"></i>
                    <h3 class="text-2xl font-semibold text-gray-400 mb-2">No Orders Yet</h3>
                    <p class="text-gray-500 mb-6">Start shopping to see your orders here!</p>
                    <a href="/mobkart" class="bg-cyan-500 hover:bg-cyan-600 px-8 py-3 rounded-lg font-semibold transition-colors">
                        <i class="fas fa-shopping-cart mr-2"></i>Start Shopping
                    </a>
                </div>
            <% } else { %>
                <div class="space-y-4">
                    <% orders.forEach((order, index) => { %>
                        <div class="order-card rounded-xl p-6">
                            <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between">
                                <div class="flex-1">
                                    <div class="flex items-center space-x-4 mb-3">
                                        <h3 class="text-xl font-semibold">Order #<%= order._id.toString().slice(-8).toUpperCase() %></h3>
                                        <span class="bg-green-600 text-green-100 px-3 py-1 rounded-full text-sm font-medium">
                                            <i class="fas fa-check-circle mr-1"></i>Completed
                                        </span>
                                    </div>
                                    
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                                        <div>
                                            <p class="text-gray-300 text-sm mb-1">Order Date</p>
                                            <p class="font-medium">
                                                <i class="fas fa-calendar mr-2 text-cyan-400"></i>
                                                <%= new Date(order.createdAt).toLocaleDateString('en-US', { 
                                                    year: 'numeric', 
                                                    month: 'long', 
                                                    day: 'numeric',
                                                    hour: '2-digit',
                                                    minute: '2-digit'
                                                }) %>
                                            </p>
                                        </div>
                                        <div>
                                            <p class="text-gray-300 text-sm mb-1">Total Amount</p>
                                            <p class="font-bold text-xl text-green-400">
                                                <i class="fas fa-rupee-sign mr-1"></i><%= order.total.toLocaleString() %>
                                            </p>
                                        </div>
                                    </div>

                                    <% if (order.items && order.items.length > 0) { %>
                                        <div>
                                            <p class="text-gray-300 text-sm mb-2">Items Ordered (<%= order.items.length %>)</p>
                                            <div class="flex flex-wrap gap-2">
                                                <% order.items.forEach(item => { %>
                                                    <div class="bg-gray-700 bg-opacity-50 rounded-lg px-3 py-2 text-sm">
                                                        <span class="font-medium"><%= item.name || 'Product' %></span>
                                                        <% if (item.quantity) { %>
                                                            <span class="text-gray-400 ml-2">× <%= item.quantity %></span>
                                                        <% } %>
                                                        <% if (item.price) { %>
                                                            <span class="text-cyan-400 ml-2">₹<%= item.price.toLocaleString() %></span>
                                                        <% } %>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- Quick Actions -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mx-5 mb-5">
            <a href="/mobkart" class="glass-effect rounded-xl p-6 text-center hover:bg-white hover:bg-opacity-10 transition-all">
                <i class="fas fa-home text-3xl text-cyan-400 mb-3"></i>
                <p class="font-semibold">Continue Shopping</p>
            </a>
            <a href="/mobkart/cart" class="glass-effect rounded-xl p-6 text-center hover:bg-white hover:bg-opacity-10 transition-all">
                <i class="fas fa-shopping-cart text-3xl text-green-400 mb-3"></i>
                <p class="font-semibold">View Cart</p>
            </a>
            <a href="/mobkart/mobiles" class="glass-effect rounded-xl p-6 text-center hover:bg-white hover:bg-opacity-10 transition-all">
                <i class="fas fa-mobile-alt text-3xl text-purple-400 mb-3"></i>
                <p class="font-semibold">Browse Mobiles</p>
            </a>
            <a href="/mobkart/laptop" class="glass-effect rounded-xl p-6 text-center hover:bg-white hover:bg-opacity-10 transition-all">
                <i class="fas fa-laptop text-3xl text-yellow-400 mb-3"></i>
                <p class="font-semibold">Browse Laptops</p>
            </a>
        </div>
    </div>


